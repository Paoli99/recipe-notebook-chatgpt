# Copy to .env and adjust. No secrets are needed: the server is its own OAuth provider.

# Port and interface the HTTP server listens on.
PORT=3000
HOST=127.0.0.1

# Public origin clients use to reach this server (no trailing slash).
# Local testing (MCPJam on this machine): http://localhost:3000
# ChatGPT: your HTTPS tunnel or deployment, e.g. https://recipes.example.com
PUBLIC_URL=http://localhost:3000

# SQLite file for users, OAuth clients/tokens, ingredients and recipes.
DATABASE_PATH=./data/recipe-notebook.db

# Extra image origins the panel may load recipe photos from (CSP resourceDomains).
# Photos from other domains fall back to the illustrated placeholder.
PHOTO_DOMAINS=https://images.unsplash.com,https://i.imgur.com,https://upload.wikimedia.org
